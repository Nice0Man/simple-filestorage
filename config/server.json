{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "max_threads": 8
  },
  "storage": {
    "root_path": "/app/files",
    "max_file_size": 104857600,
    "allowed_extensions": ["*"]
  },
  "auth": {
    "token_lifetime_hours": 24
  },
  "logging": {
    "level": "info",
    "file": "/app/logs/server.log"
  }
}
