# Dockerfile for local build
# Uses locally built binaries to speed up development

# ================================
# Stage 1: Production Runtime
# ================================
FROM ubuntu:22.04 AS production

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install only runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    libcurl4 \
    libpq5 \
    libstdc++6 \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean \
    && groupadd -r fileserver \
    && useradd -r -g fileserver -s /bin/false fileserver

# Create application directories
RUN mkdir -p /app/bin /app/lib /app/files /app/logs /app/config /app/docs \
    && chown -R fileserver:fileserver /app

# Copy locally built binary and libraries
COPY build/bin/fileserver /app/bin/
COPY build/lib/*.a /app/lib/

# Copy configuration
COPY config/ /app/config/

# Set permissions
RUN chmod +x /app/bin/fileserver \
    && chown -R fileserver:fileserver /app

# Switch to non-root user
USER fileserver

# Set working directory
WORKDIR /app

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Default command
CMD ["/app/bin/fileserver", "/app/config/server.json"]

# Build metadata
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION=1.0.0

LABEL maintainer="FileServer Team" \
      org.label-schema.build-date=$BUILD_DATE \
      org.label-schema.name="fileserver" \
      org.label-schema.description="High-performance C++ File Server (Local Build)" \
      org.label-schema.vcs-ref=$VCS_REF \
      org.label-schema.vendor="FileServer Team" \
      org.label-schema.version=$VERSION \
      org.label-schema.schema-version="1.0"

