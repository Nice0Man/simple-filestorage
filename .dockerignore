# Ignore build artifacts to speed up Docker context
build/
build_test/
.git/
.github/
*.log
*.swp
*.swo
*~
.vscode/
.idea/
*.o
*.a
*.so
*.exe

# Keep only necessary files for Docker build
!build/bin/fileserver
!build/lib/*.a

# Node modules (if any)
node_modules/
client/node_modules/
client/.next/
client/dist/
client/build/

# Test files (keep tests/ for Docker build)
*.test
*.spec

# Documentation (we copy it explicitly)
docs/*.md

# Temporary files
tmp/
temp/
*.tmp

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
